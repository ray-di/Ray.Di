parameters:
  errorFormat: raw
  level: max
  paths:
    - src/di
    - tests/di
    - tests/type
  scanFiles:
    - tests/stub/Swoole.phpstub
  excludePaths:
    - tests/tmp/*
    - tests/di/tmp/*
    - tests/Di/tmp/*
    - tests/di/Fake/*
    - tests/di/Ray_Di_*
    - tests/di/script/*
  ignoreErrors:
    - '#contains generic class ReflectionAttribute but does not specify its types:#'
    - '#generic class ReflectionAttribute but does not specify its types:#'
    - '#will always evaluate to true#'
